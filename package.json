{
  "name": "breedz",
  "version": "0.0.1",
  "description": "BreedZ is a herd management app for tracking cattle breeding records, animal lineage, and farm activity.",
  "productName": "BreedZ",
  "author": "lypzis <victor.piccoli@pm.me>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\"",
    "test": "node --test",
    "dev": "quasar dev",
    "dev:ssr": "quasar dev -m ssr",
    "dev:stripe": "stripe listen --forward-to http://localhost:8888/.netlify/functions/stripe-webhook",
    "build": "quasar build",
    "build:public-pages": "node scripts/generate-static-public-pages.mjs",
    "build:ssr": "quasar build -m ssr",
    "build:netlify": "npm run build:ssr && rm -rf dist/ssr/node_modules && node scripts/prepare-netlify-ssr-redirects.mjs",
    "dev:netlify": "npm run build:netlify && netlify dev -d dist/ssr/client -f netlify/functions --framework '#custom'",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.6.0",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "register-service-worker": "^1.7.2",
    "serverless-http": "^4.0.0",
    "stripe": "^18.4.0",
    "vue": "^3.5.32",
    "vue-router": "^5.0.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@quasar/app-vite": "^2.5.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "postcss": "^8.5.8",
    "vite-plugin-checker": "^0.12.0",
    "vue-eslint-parser": "^10.4.0",
    "workbox-build": "^7.4.0",
    "workbox-cacheable-response": "^7.4.0",
    "workbox-core": "^7.4.0",
    "workbox-expiration": "^7.4.0",
    "workbox-precaching": "^7.4.0",
    "workbox-routing": "^7.4.0",
    "workbox-strategies": "^7.4.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22.12",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1",
    "pnpm": ">= 10.0.0"
  }
}
